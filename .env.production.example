# انسخ هذا الملف إلى .env.production وأكمل القيم

# قاعدة البيانات (PostgreSQL) — مطلوب
DATABASE_URL=postgresql://user:password@host:5432/dbname

# سر الجلسة — اجعله نصاً عشوائياً طويلاً
SESSION_SECRET=change_this_to_random_long_string_at_least_32_chars

# Google OAuth (اختياري)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (اختياري)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# البريد الإلكتروني SMTP (اختياري)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telegram (اختياري)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHAT_ID=
