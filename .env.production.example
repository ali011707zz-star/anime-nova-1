## Optional self-hosted translation service on the VPS.
## Argos is tried first; existing LibreTranslate/Google/MyMemory fallbacks stay enabled.
# ARGOS_TRANSLATE_URL=http://127.0.0.1:5001/translate
# ARGOS_TRANSLATE_TIMEOUT_MS=8000
# ============================================================
#  Nova Anime — Production Environment Variables Template
#  Copy this file to /opt/anime-nova/.env on the VPS
#  NEVER commit .env files with real values to git
# ============================================================

# Database
DATABASE_URL=postgresql://anime_nova:CHANGE_ME@localhost:5432/anime_nova

# Telegram bot
TELEGRAM_BOT_TOKEN=           # e.g. 1234567890:AAxxxx
TELEGRAM_CHANNEL_ID=          # e.g. -1001234567890
TELEGRAM_CHAT_ID=             # numeric chat id

# Email — Resend API (مُفضَّل، يعمل حتى لو SMTP محجوب)
# سجّل مجاناً على resend.com وأنشئ مفتاح API
RESEND_API_KEY=               # re_xxxxxxxxxxxx
RESEND_FROM=                  # "Anime NOVA <no-reply@yourdomain.com>" — أو اتركه فارغاً لاستخدام onboarding@resend.dev

# Email (SMTP) — fallback إذا لم يُضبَط Resend
SMTP_USER=                    # gmail address
SMTP_PASS=                    # gmail app-password (not account password)

# App secrets — generate with: openssl rand -hex 32
SESSION_SECRET=
APP_SECRET=

# Cloudflare proxy
CF_PROXY_KEY=                 # shared secret between cf_proxy.py and api-server
CF_WORKER_URL=                # https://nova-cdn-proxy.xxx.workers.dev

# Internal MediaFlow proxy
MEDIAFLOW_API_PASSWORD=      # required by the local MediaFlow service

# Supabase
SUPABASE_URL=                 # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=         # service_role JWT — NEVER expose client-side

# Optional integrations
CINESRC_BASE=http://localhost:13004
HOPX_API_KEY=
APP_DOMAIN=animenovaa.duckdns.org
ANIVEXA_API_URL=http://127.0.0.1:8787
# Self-hosted Consumet API (managed by PM2 on the VPS)
CONSUMET_API_URL=http://127.0.0.1:3000
