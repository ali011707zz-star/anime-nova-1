# ============================================================
#  Nova Anime — Production Environment Variables Template
#  Copy this file to /opt/anime-nova/.env on the VPS
#  NEVER commit .env files with real values to git
# ============================================================

# Database
DATABASE_URL=postgresql://anime_nova:CHANGE_ME@localhost:5432/anime_nova

# Telegram bot
TELEGRAM_BOT_TOKEN=           # e.g. 1234567890:AAxxxx
TELEGRAM_CHANNEL_ID=          # e.g. -1001234567890
TELEGRAM_CHAT_ID=             # numeric chat id

# Email (SMTP)
SMTP_USER=                    # gmail address
SMTP_PASS=                    # gmail app-password (not account password)

# App secrets — generate with: openssl rand -hex 32
SESSION_SECRET=
APP_SECRET=

# Cloudflare proxy
CF_PROXY_KEY=                 # shared secret between cf_proxy.py and api-server
CF_WORKER_URL=                # https://nova-cdn-proxy.xxx.workers.dev

# Supabase
SUPABASE_URL=                 # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=         # service_role JWT — NEVER expose client-side

# Optional integrations
CINESRC_BASE=http://localhost:13004
HOPX_API_KEY=
APP_DOMAIN=animenovaa.duckdns.org
