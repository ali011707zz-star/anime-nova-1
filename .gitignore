# Large binary files - do not commit
artifacts/api-server/bin/
anime-nova-1/artifacts/api-server/bin/
**/bin/yt-dlp
**/bin/yt-dlp_*

# Attached assets (screenshots/videos from chat - not needed in repo)
attached_assets/
anime-nova-1/attached_assets/

# Agent memory files — may contain API keys/tokens from research (never commit)
.agents/

# Environment files with real secrets (use .env.example instead)
.env
.env.local
.env.production

# Decompiled APK artifacts — contain embedded Firebase/Google API keys (NEVER commit)
nova-player-rebrand/
nova-player-rebrand-final/
nova-player-build/
nova-player-build-final/

# APK binaries
*.apk
*.keystore
*.jks
artifacts/nova-mobile/google-services.json

# JADX input/output for the archived Nova Mobile 2 reference project (contains
# embedded third-party keys and the original APK binary)
archive/prototypes/nova-mobile-2/extracted/

