modules = ["python-3.11", "bash", "postgresql-16", "nodejs-22"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]
build = ["sh", "-c", "pnpm install --prefer-offline && pnpm --filter @workspace/api-server run build && VITE_API_URL= pnpm --filter @workspace/anime-scraper run build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CF Proxy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "CF Proxy"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CF_PROXY_PORT=8000 python3 scripts/cf_proxy.py"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && PORT=5000 node --enable-source-maps ./dist/index.mjs"
waitForPort = 5000

[agent]
stack = "FLASK_VANILLA_JS"
expertMode = true
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_database:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[nix]
channel = "stable-25_05"
packages = ["openssl", "postgresql"]

[userenv]

[userenv.shared]
PORT = "5000"
BASE_PATH = "/"
NODE_ENV = "production"
CF_PROXY_PORT = "8000"
TELEGRAM_SCHEDULER_ENABLED = "true"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
ORKESTR_RELAY_URL = "https://animenovaa.duckdns.org"
ORKESTR_PROJECT_ID = "69e4e91d-22a1-4b4e-ac3f-00bac7bc5c4d"
SCRAPERAPI_KEY = "8044e1c6275e5031ffaadf156d9e62d7"
DUCKDNS_TOKEN = "d0404bbc-becf-44b2-a60f-b1b27d4c8d22"
DUCKDNS_DOMAIN = "animenovaa"
APP_SECRET = "anime-nova-replit-m3ub1498afax5ci25svl5"
