modules = ["nodejs-20", "python-3.11", "bash", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --prefer-offline && pnpm --filter @workspace/api-server run build && VITE_API_URL= pnpm --filter @workspace/anime-scraper run build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "artifacts/api-server: API Server"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["openssl", "postgresql"]

[userenv]

[userenv.shared]
PORT = "5000"
BASE_PATH = "/"
NODE_ENV = "production"
CF_PROXY_PORT = "8000"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
NOVA_PROXY_BASE = "https://animenovaa.duckdns.org"
VPS_HOST = "95.182.93.105"
VPS_USER = "root"

[userenv.development]
CF_WORKER_URL = "http://localhost:8000/stream"
