modules = ["python-3.11", "web", "nodejs-22"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]
build = ["bash", "-c", "pnpm install && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/anime-scraper run build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CF Proxy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Nova Mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Whisper Service"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ artifacts/anime-scraper/node_modules/.bin/vite --config artifacts/anime-scraper/vite.config.ts --host 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "Start API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 node --enable-source-maps artifacts/api-server/dist/index.mjs"
waitForPort = 8080

[[workflows.workflow]]
name = "CF Proxy"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install flask curl_cffi -q && CF_PROXY_PORT=8000 python3.11 scripts/cf_proxy.py"
waitForPort = 8000

[[workflows.workflow]]
name = "Nova Mobile"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install && EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN PORT=8099 BASE_PATH=/nova-mobile/ pnpm --filter @workspace/nova-mobile run dev"
waitForPort = 8099

[[workflows.workflow]]
name = "Whisper Service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "WHISPER_PORT=9000 WHISPER_MODEL=small python3.11 scripts/whisper_service.py"
waitForPort = 9000

[agent]
stack = "FLASK_VANILLA_JS"
expertMode = true
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_database:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 4000
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 8100
externalPort = 5000

[[ports]]
localPort = 9000
externalPort = 9000

[[ports]]
localPort = 23209
externalPort = 5173

[[ports]]
localPort = 23210
externalPort = 3002

[[ports]]
localPort = 24968
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

