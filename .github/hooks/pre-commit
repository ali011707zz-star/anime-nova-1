#!/usr/bin/env bash
# Pre-commit hook: block commits that contain high-entropy secrets
# Install: cp .github/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

PATTERNS=(
  "AIza[A-Za-z0-9_-]{35}"          # Google API key
  "[0-9]{8,}:[A-Za-z0-9_-]{30,}"   # Telegram bot token
  "eyJhbGciOiJIUzI1NiJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"  # JWT (Supabase/etc)
  "hopx_live_[A-Za-z0-9._-]+"      # Hopx API key
  "SUPABASE_SERVICE_KEY\s*=\s*['\"]?eyJ"  # Supabase service key inline
  "TELEGRAM_BOT_TOKEN\s*=\s*['\"]?[0-9]" # Inline Telegram token
)

FAILED=0
for pattern in "${PATTERNS[@]}"; do
  MATCHES=$(git diff --cached --name-only | xargs grep -Erl "$pattern" 2>/dev/null || true)
  if [ -n "$MATCHES" ]; then
    echo ""
    echo "🚨 SECRET LEAK DETECTED — commit blocked!"
    echo "   Pattern: $pattern"
    echo "   Files:   $MATCHES"
    echo ""
    echo "   ➜ Move the value to /opt/anime-nova/.env and reference it via process.env.VAR_NAME"
    echo "   ➜ Add the file to .gitignore if it should never be committed"
    echo ""
    FAILED=1
  fi
done

if [ $FAILED -eq 1 ]; then
  exit 1
fi

# Also block committing .agents/ memory directory
AGENT_FILES=$(git diff --cached --name-only | grep "^\.agents/" || true)
if [ -n "$AGENT_FILES" ]; then
  echo ""
  echo "🚨 BLOCKED: .agents/ memory files must not be committed (may contain API keys from research)"
  echo "   Files: $AGENT_FILES"
  echo "   ➜ Run: git rm --cached -r .agents/"
  echo ""
  exit 1
fi

exit 0
