<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:id="@+id/content_rating_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/content_rating_level"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/severity_color"
        android:background="@drawable/rectangle_border"
        android:layout_width="8dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/content_rating_type"/>
    <TextView
        android:id="@+id/content_rating_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/votes_count"
        app:layout_constraintEnd_toStartOf="@+id/severity_color"
        app:layout_constraintTop_toBottomOf="@+id/content_rating_type"
        style="@style/TextAppearance.AppCompat.Subhead"/>
    <TextView
        android:id="@+id/votes_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toStartOf="@+id/severity_color"
        app:layout_constraintTop_toBottomOf="@+id/content_rating_level"
        style="@style/TextAppearance.AppCompat.Small"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/abstractColorDivider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/content_rating_question"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/votes_count"/>
    <TextView
        android:id="@+id/content_rating_question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/TextAppearance.AppCompat.Caption"/>
    <com.anslayer.widget.RightAlignedHorizontalScrollView
        android:id="@+id/horizontal_scroll"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/content_rating_question">
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_gravity="end"
            android:id="@+id/toggle_vote_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">
            <Button
                android:id="@+id/severe_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="شديد"
                style="?attr/materialButtonOutlinedStyle"/>
            <Button
                android:id="@+id/moderate_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متوسط"
                style="?attr/materialButtonOutlinedStyle"/>
            <Button
                android:id="@+id/mild_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خفيف"
                style="?attr/materialButtonOutlinedStyle"/>
            <Button
                android:id="@+id/none_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="لا يوجد"
                style="?attr/materialButtonOutlinedStyle"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.anslayer.widget.RightAlignedHorizontalScrollView>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
