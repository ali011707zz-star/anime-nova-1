<?xml version="1.0" encoding="utf-8"?>
<com.nguyenhoanglam.progresslayout.ProgressLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/progressLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:errorButtonTextColor="?attr/colorAccent"
    app:loadingProgressBarColor="?attr/colorAccent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/seriesNestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/character_cover"
                android:background="@drawable/rounded_rectangle"
                android:layout_width="145dp"
                android:layout_height="185dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textStyle="bold"
                android:id="@+id/character_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/character_cover"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2"
                android:id="@+id/character_love_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/heart"
                app:layout_constraintTop_toBottomOf="@+id/character_name"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/heart"
                android:padding="3dp"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:layout_constraintEnd_toStartOf="@+id/character_love_count"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/liked_text"
                app:layout_constraintTop_toBottomOf="@+id/character_name"
                app:srcCompat="@drawable/ic_heart_grey_600_24dp"/>
            <TextView
                android:id="@+id/liked_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اعجب بهذه الشخصية"
                app:layout_constraintEnd_toStartOf="@+id/heart"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/character_name"/>
            <TextView
                android:textSize="14sp"
                android:gravity="right"
                android:id="@+id/character_description"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/liked_text"
                style="@style/TextAppearance.Regular.Body1"/>
            <View
                android:id="@+id/divider"
                android:background="?android:attr/listDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/character_description"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textSize="16sp"
                android:id="@+id/voice_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="المؤدي الصوتي"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/voice_actors_list"
                android:paddingBottom="4dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:foregroundGravity="center"
                android:scaleX="-1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/voice_header"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textSize="16sp"
                android:id="@+id/anime_header"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="الانميات"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/voice_actors_list"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/anime_list"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/anime_header"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</com.nguyenhoanglam.progresslayout.ProgressLayout>
