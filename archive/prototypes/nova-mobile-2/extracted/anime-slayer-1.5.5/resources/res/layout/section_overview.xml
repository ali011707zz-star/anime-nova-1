<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="-32dp"
        android:alpha="0.2"
        app:layout_constraintBottom_toBottomOf="@+id/anime_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/backdrop_overlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/backdrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/anime_info"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.anslayer.widget.SlayerImage
            android:id="@+id/seriesImage"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="15sp"
                android:ellipsize="end"
                android:id="@+id/seriesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="4"
                style="@style/TextAppearance.Medium.Title"/>
            <TextView
                android:id="@+id/seriesStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textIsSelectable="false"
                style="@style/TextAppearance.Regular.Body1.Secondary"/>
            <TextView
                android:id="@+id/seriesYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_margin"
                android:textIsSelectable="false"
                style="@style/TextAppearance.Regular.Body1.Secondary"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_margin">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/seriesAgeRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textIsSelectable="false"
                    style="@style/TextAppearance.Regular.Body1.Secondary"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ageRatingSeperator"
                    android:background="?attr/separatorColor"
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="0.7dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/episodeNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textIsSelectable="false"
                    style="@style/TextAppearance.Regular.Body1.Secondary"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/epsiodeNumberSperator"
                    android:background="?attr/separatorColor"
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="0.7dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/seriesType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textIsSelectable="false"
                    style="@style/TextAppearance.Regular.Body1.Secondary"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@+id/seriesRatingSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anime_info"
        layout="@layout/section_rating"/>
</androidx.constraintlayout.widget.ConstraintLayout>
