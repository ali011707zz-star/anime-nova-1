<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textStyle="bold"
        android:id="@+id/trailer_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="العرض الدعائي"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/thumbnail"
        android:background="@drawable/rounded_rectangle_trailer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trailer_head"/>
    <FrameLayout
        android:background="@drawable/circular_shadow"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnail"
        app:layout_constraintEnd_toEndOf="@+id/thumbnail"
        app:layout_constraintStart_toStartOf="@+id/thumbnail"
        app:layout_constraintTop_toTopOf="@+id/thumbnail">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/play_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_player_play"
            app:tint="@color/md_white_1000"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
