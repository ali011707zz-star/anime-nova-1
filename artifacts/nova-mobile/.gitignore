# intentionally ignore generated native projects, not hand-written module code.
!modules/
!modules/nova-media3/
!modules/nova-media3/android/
!modules/nova-media3/android/src/
!modules/nova-media3/android/src/main/
!modules/nova-media3/android/src/main/java/
!modules/nova-media3/android/src/main/java/expo/
!modules/nova-media3/android/src/main/java/expo/modules/
!modules/nova-media3/android/src/main/java/expo/modules/novamedia3/
!modules/nova-media3/android/src/main/java/expo/modules/novamedia3/NovaVolumeModule.kt
!modules/nova-media3/ios/
