{
  "expo": {
    "name": "ANIME NOVA",
    "slug": "anime-nova-",
    "owner": "ali011707s-team",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "nova-mobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nova.anime",
      "backgroundColor": "#09090B",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#09090B"
      },
      "package": "com.nova.anime",
      "backgroundColor": "#09090B",
      "usesCleartextTraffic": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://animenovaa.duckdns.org"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-video",
      "expo-screen-orientation",
      "expo-brightness",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7738594986393012~6244006922",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "يسمح هذا الإذن بحفظ لقطات المشاهدة في معرض الصور.",
          "savePhotosPermission": "يسمح هذا الإذن بحفظ لقطات المشاهدة في معرض الصور."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "تسمح هذه الأذونات للتطبيق بالوصول إلى صورك.",
          "cameraPermission": "تسمح هذه الأذونات للتطبيق باستخدام الكاميرا."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "anime-nova",
          "project": "react-native"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/nova-mobile"
    },
    "extra": {
      "eas": {
        "projectId": "07296477-c5e8-4a47-a804-95f28b46ef7b"
      }
    }
  }
}
