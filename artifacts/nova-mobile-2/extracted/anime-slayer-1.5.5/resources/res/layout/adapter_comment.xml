<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/comment_thread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="top"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?android:attr/listPreferredItemHeight">
            <Space
                android:id="@+id/left_margin"
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/comment_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:layout_marginEnd="16dp"
                android:layout_toEndOf="@+id/left_margin"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"/>
            <include
                android:id="@+id/comment_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/comment_avatar"
                layout="@layout/comment_metadata_above"/>
            <TextView
                android:textColor="?attr/yt_text_secondary"
                android:id="@+id/comment_expand_button"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/read_more"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_below="@+id/comment_metadata"
                android:layout_alignParentRight="true"
                style="@style/TextAppearance.Regular.Body1.Secondary"/>
            <com.anslayer.widget.SlayerCommentAction
                android:id="@+id/commentWidget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/comment_expand_button"
                android:layout_marginStart="-16dp"
                android:layout_toEndOf="@+id/comment_avatar"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:gravity="bottom"
        android:id="@+id/comment_divider"
        android:background="?attr/abstractColorDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@null"/>
</LinearLayout>
