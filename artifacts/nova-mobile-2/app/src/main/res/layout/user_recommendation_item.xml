<?xml version="1.0" encoding="utf-8"?>
<com.anslayer.widget.SlayerCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/lg_margin">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:padding="@dimen/lg_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0">
                <io.wax911.support.custom.widget.SingleLineTextView
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/if_you_liked"/>
                <com.anslayer.widget.SlayerImage
                    android:id="@+id/seriesImage"
                    android:layout_width="@dimen/series_image_xs"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scaleType="centerCrop"/>
                <io.wax911.support.custom.widget.SingleLineTextView
                    android:textColor="@color/colorStateBlue"
                    android:layout_gravity="center"
                    android:id="@+id/seriesTitle"
                    android:padding="@dimen/lg_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:layout_weight="3"
                app:srcCompat="@drawable/ic_shuffle_grey_600_24dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0">
                <io.wax911.support.custom.widget.SingleLineTextView
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/you_might_like"/>
                <com.anslayer.widget.SlayerImage
                    android:id="@+id/seriesImageRecommended"
                    android:layout_width="@dimen/series_image_xs"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scaleType="centerCrop"/>
                <io.wax911.support.custom.widget.SingleLineTextView
                    android:textColor="@color/colorStateBlue"
                    android:layout_gravity="center"
                    android:id="@+id/recommendSeriesTitle"
                    android:padding="@dimen/lg_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/approved"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/check_circle"/>
            <TextView
                android:id="@+id/recommendationComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</com.anslayer.widget.SlayerCard>
