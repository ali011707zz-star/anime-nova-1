<?xml version="1.0" encoding="utf-8"?>
<com.anslayer.widget.SlayerCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/lg_margin">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:background="?attr/colorSurface"
        android:padding="@dimen/lg_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.anslayer.widget.SlayerAvatar
            android:id="@+id/recommendationAuthorAvatar"
            android:layout_width="@dimen/avatar_ripple_radius"
            android:layout_height="@dimen/avatar_ripple_radius"/>
        <Space
            android:layout_width="@dimen/lg_margin"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <io.wax911.support.custom.widget.SingleLineTextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/full_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/recommendationLikeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/spacing_small"
                        app:srcCompat="@drawable/ic_heart_outline_grey_600_24dp"/>
                    <io.wax911.support.custom.widget.SingleLineTextView
                        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/recommendationLikeCounts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </FrameLayout>
            <Space
                android:layout_width="wrap_content"
                android:layout_height="@dimen/lg_margin"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/recommendationComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.anslayer.widget.SlayerCard>
