<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/user_cover"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_profile_button"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="تعديل الملف الشخصي"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_cover"
                    style="@style/Theme.Widget.Button.Outline.Profile"/>
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/user_image"
                    android:padding="2dp"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:scaleType="centerCrop"
                    android:layout_marginStart="11dp"
                    app:layout_constraintBottom_toBottomOf="@+id/user_cover"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_cover"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
                    app:strokeColor="?android:attr/colorBackground"
                    app:strokeWidth="3dp"/>
                <io.wax911.support.custom.widget.SingleLineTextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:id="@+id/full_name_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_image"/>
                <TextView
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/yt_material_blue_500"
                    android:id="@+id/role"
                    android:background="@drawable/role_rectangle"
                    android:padding="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/full_name_label"
                    app:layout_constraintStart_toEndOf="@+id/full_name_label"
                    app:layout_constraintTop_toTopOf="@+id/full_name_label"
                    style="@style/TextAppearance.Regular.Caption"/>
                <io.wax911.support.custom.widget.SingleLineTextView
                    android:id="@+id/username_label"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/full_name_label"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/profile_user_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/username_label">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/user_bio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:includeFontPadding="false"
                        android:textAlignment="viewStart"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/icon_items_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <View
                        android:background="?attr/abstractColorDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/chart_container"
                    android:padding="@dimen/lg_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/profile_user_details">
                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/userStatsBarChart"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"/>
                    <io.wax911.support.custom.widget.SingleLineTextView
                        android:textSize="11dp"
                        android:gravity="right"
                        android:layout_gravity="start"
                        android:id="@+id/total_watched_episodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.appbar.MaterialToolbar
            android:theme="@style/ThemeOverlay.Widget.Toolbar.MyProfile"
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/back_profile"/>
    </FrameLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
